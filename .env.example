# Bu dosyayı ".env" adıyla kopyala ve kendi anahtarını yaz.
# .env dosyası ASLA GitHub'a yüklenmemeli (.gitignore'da zaten var).

# Hangi sağlayıcıyı kullanacaksın: openai veya anthropic
LLM_PROVIDER=openai

# İlgili sağlayıcının anahtarı (sadece kullandığını doldurman yeterli)
OPENAI_API_KEY=buraya-anahtarini-yaz
ANTHROPIC_API_KEY=

# Embedding modu: local (ücretsiz, indirme gerektirir) veya openai (hızlı, cüzi ücretli)
# local seçersen ek olarak: pip install sentence-transformers
EMBEDDING_MODE=openai
